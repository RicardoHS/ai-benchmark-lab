{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ricardohs.github.io/schemas/creative-report-entry-v1.json",
  "title": "Public creative benchmark report index entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "title",
    "summary",
    "published_at",
    "prompt_id",
    "candidate_labels",
    "timing",
    "demo_url",
    "code_url",
    "cover_image_url",
    "verification_status"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "report_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "title": {"type": "string", "minLength": 3, "maxLength": 160},
    "summary": {"type": "string", "minLength": 10, "maxLength": 320},
    "published_at": {"type": "string", "format": "date-time"},
    "prompt_id": {"const": "creative-benchmark-report-v1.0.0"},
    "candidate_labels": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_wall_seconds", "total_wall_seconds", "budget_seconds", "timed_out"],
      "properties": {
        "agent_wall_seconds": {"type": "number", "minimum": 0},
        "total_wall_seconds": {"type": "number", "minimum": 0},
        "budget_seconds": {"type": "number", "minimum": 0},
        "timed_out": {"type": "boolean"}
      }
    },
    "demo_url": {"type": "string", "format": "uri"},
    "code_url": {"type": "string", "format": "uri"},
    "cover_image_url": {"type": "string", "format": "uri"},
    "result_urls": {
      "type": "array",
      "items": {"type": "string", "format": "uri"}
    },
    "verification_status": {
      "enum": ["passed", "passed-with-notes"]
    },
    "known_limitations": {
      "type": "array",
      "items": {"type": "string"}
    },
    "tags": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    }
  }
}
